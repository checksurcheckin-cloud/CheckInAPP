{
  "expo": {
    "name": "Check In",
    "slug": "checkin-mobile",
    "owner": "checksurcheckins-team",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.horaires.checkin"
    },
    "android": {
      "package": "com.horaires.checkin"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5708f7bd-00b6-4ae6-b03c-123a0583beb3"
      }
    }
  }
}
