{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @horaires/backend build"
  },
  "deploy": {
    "startCommand": "sh -c 'cd /app/apps/backend && /app/node_modules/.bin/prisma migrate deploy && node dist/main'",
    "healthcheckPath": "/api-docs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
