{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @horaires/backend build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @horaires/backend exec prisma migrate deploy"],
    "startCommand": "node /app/apps/backend/dist/main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
