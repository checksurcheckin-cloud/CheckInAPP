DATABASE_URL="postgresql://horaires:horaires_dev_password@localhost:5432/horaires_app?schema=public"

JWT_ACCESS_SECRET="change-me-en-une-longue-chaine-aleatoire"
JWT_REFRESH_SECRET="change-me-aussi-une-autre-chaine-aleatoire"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Token émis à un SiteDevice (checkin-pos) après authentification via qrSecret —
# secret distinct des tokens utilisateur pour ne jamais confondre les deux.
JWT_DEVICE_SECRET="change-me-encore-une-longue-chaine-aleatoire"
JWT_DEVICE_EXPIRES_IN="12h"

PORT=3000
